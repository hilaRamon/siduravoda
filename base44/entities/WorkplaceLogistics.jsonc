      "format": "date",
      "description": "תאריך"
    },
    "workplace_id": {
      "type": "string",
      "description": "מזהה מקום עבודה"
    },
    "driver_student_id": {
      "type": "string",
      "description": "מזהה נהג (תלמיד)"
    },
    "vehicle_id": {
      "type": "string",
      "description": "מזהה רכב 1"
    },
    "vehicle_id_2": {
      "type": "string",
      "description": "מזהה רכב 2"
    },
    "vehicle_id_3": {
      "type": "string",
      "description": "מזהה רכב 3"
    },
    "exit_time": {
      "type": "string",
      "description": "שעת יציאה"
    },
    "notes": {
      "type": "string",
      "description": "הערות"
    }
  },
  "required": [
    "date",
    "workplace_id"
  ]
}
