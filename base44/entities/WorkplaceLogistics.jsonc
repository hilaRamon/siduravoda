{
  "name": "WorkplaceLogistics",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "תאריך"
    },
    "workplace_id": {
      "type": "string",
      "description": "מזהה מקום עבודה"
    },
    "driver_student_id": {
      "type": "string",
      "description": "מזהה נהג (תלמיד)"
    },
    "vehicle_id": {
      "type": "string",
      "description": "מזהה רכב 1"
    },
    "vehicle_id_2": {
      "type": "string",
      "description": "מזהה רכב 2"
    },
    "vehicle_id_3": {
      "type": "string",
      "description": "מזהה רכב 3"
    },
    "exit_time": {
      "type": "string",
      "description": "שעת יציאה"
    },
    "notes": {
      "type": "string",
      "description": "הערות"
    },
    "is_piecework": {
      "type": "boolean",
      "description": "עבודת קבלנות",
      "default": false
    },
    "units_name": {
      "type": "string",
      "description": "שם יחידה"
    },
    "units": {
      "type": "number",
      "description": "כמות יחידות מאושרת"
    },
    "reported_units": {
      "type": "number",
      "description": "כמות יחידות שממתינה לאישור"
    },
    "units_status": {
      "type": "string",
      "enum": ["ממתין", "אושר", "נדחה"],
      "description": "סטטוס אישור הכמות"
    },
    "rate": {
      "type": "number",
      "description": "תעריף ליחידה"
    }
  },
  "required": [
    "date",
    "workplace_id"
  ]
}
