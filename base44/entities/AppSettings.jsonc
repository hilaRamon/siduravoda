{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "pricing_method": {
      "type": "string",
      "enum": ["hourly", "daily"],
      "description": "שיטת תמחור גלובלית",
      "default": "hourly"
    },
    "default_rate": {
      "type": "number",
      "description": "תעריף שעתי ברירת מחדל (₪ לשעה)",
      "default": 40
    },
    "default_hours": {
      "type": "number",
      "description": "כמות שעות ברירת מחדל לשיבוץ",
      "default": 4.75
    },
    "default_daily_rate": {
      "type": "number",
      "description": "תעריף יומי ברירת מחדל (₪ ליום)",
      "default": 235
    },
    "hours_per_daily_unit": {
      "type": "number",
      "description": "שעות ליחידה יומית — משמש להמרה בין תעריף יומי לשעתי",
      "default": 4.75
    },
    "attendance_did_not_leave": {
      "type": "array",
      "items": { "type": "string" },
      "description": "מזהי מקומות עבודה בעמודת לא יצא לעבודה בדוח נוכחות. חסר — נכתב מהשמות שבברירת המחדל. מערך שמור, גם ריק, נשאר כמו שהוא."
    },
    "attendance_did_not_work": {
      "type": "array",
      "items": { "type": "string" },
      "description": "מזהי מקומות עבודה בעמודת לא עבד בדוח נוכחות. חסר — נכתב מהשמות שבברירת המחדל. מערך שמור, גם ריק, נשאר כמו שהוא."
    },
    "attendance_studies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "מזהי מקומות עבודה בעמודת לימודים בדוח נוכחות. חסר — נכתב מהשמות שבברירת המחדל. מערך שמור, גם ריק, נשאר כמו שהוא."
    }
  },
  "required": []
}
